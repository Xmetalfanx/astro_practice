---
// This should have a unique ID to target the aside links.

// this should also have an a href tag that links to the top of the page
---

<div class="mobile_menu_related">
  <!-- Link to send things back to the top of page (the main content on mobile) -->
  <a href="#backtotop">Back to Top</a>

  <!-- Target for Link to Menu -->
  <div id="asidetarget"></div>
</div>


<style>
  .mobile_menu_related {
    display: none;
    // what is this (below) for if display is none?
    // writing-mode: horizontal-tb;

    @media ($breakpoint-sm) {
      @include links;

      display: block;
      margin: 1rem auto;
      scroll-behavior: smooth;
    }
  }

</style>